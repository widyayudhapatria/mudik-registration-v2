APP_NAME="Mudik Lebaran 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mudik_lebaran
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Pusher Configuration
PUSHER_APP_ID=your_app_id
PUSHER_APP_KEY=your_app_key
PUSHER_APP_SECRET=your_app_secret
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

# Email Configuration (Zeptomail/Mailgun)
MAIL_MAILER=smtp
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mudiklebaran.id"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: Mailgun
# MAILGUN_DOMAIN=your_domain
# MAILGUN_SECRET=your_secret
# MAILGUN_ENDPOINT=api.mailgun.net

# QR Code Configuration
QR_CODE_SIZE=300
QR_CODE_MARGIN=2
QR_CODE_FORMAT=png

# Form Link Configuration
FORM_LINK_EXPIRY_DAYS=3
FORM_LINK_MAX_RESEND=5

# Rate Limiting
RATE_LIMIT_EMAIL_SUBMISSION=5
RATE_LIMIT_WINDOW_MINUTES=10

# File Upload
MAX_FILE_SIZE=2048
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf